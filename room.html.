/* ═══════════ WALL TOGGLE ═══════════ */
const wallGroups = { wallBack, wallLeft, wallRight, wallFront };

window.setWalls = function(mode) {
  document.querySelectorAll('#ui button').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');

  wallBack.visible  = true;
  wallLeft.visible  = true;
  wallRight.visible = true;
  wallFront.visible = true;
  floorGrp.visible  = true;

  if (mode === 'back') {
    wallRight.visible = false;
    wallFront.visible = false;
  } else if (mode === 'floor') {
    wallBack.visible  = false;
    wallLeft.visible  = false;
    wallRight.visible = false;
    wallFront.visible = false;
  }
};

/* ───── resize ───── */
window.addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

/* ───── animate ───── */
function animate() {
  requestAnimationFrame(animate);
  controls.update();
  renderer.render(scene, camera);
}
animate();
